{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "types": ["vite/client"], "resolveJsonModule": true,
    "baseUrl": "..", "paths": {"@/*": ["./*"]}
  },
  "include": ["**/*.ts", "**/*.vue", "../lib/design-model.ts", "../lib/design-renderer.ts", "../lib/design-copy.ts"]
}
