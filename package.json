{
  "name": "yiaijia-web",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev-vue.mjs",
    "build": "pnpm build:ui && next build --webpack",
    "start": "node scripts/start-server.mjs",
    "setup": "node scripts/setup.mjs",
    "user:create": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/create-user.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p frontend/tsconfig.json",
    "build:ui": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p frontend/tsconfig.json && node node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@lucide/vue": "^1.48.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "vue": "^3.5.43",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
