# Copy to /etc/zhijing.env. These values must match the server build.
APP_URL=https://jxcymj.asia
APP_LOCAL_MODE=0
NEXT_PUBLIC_APP_LOCAL_MODE=0
NEXT_PUBLIC_APP_BASE_PATH=/zhijing
PORT=3010
DATA_DIR=/var/lib/zhijing
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Create the first account through scripts/create-user.mjs using stdin.
# Do not keep account passwords or API keys in this file.
