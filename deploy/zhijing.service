[Unit]
Description=Zhijing textile design workbench
After=network.target

[Service]
Type=simple
User=zhijing
Group=zhijing
WorkingDirectory=/opt/zhijing/current
EnvironmentFile=/etc/zhijing.env
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/opt/zhijing/runtime/bin/node /opt/zhijing/current/scripts/start-server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zhijing /var/lib/zhijing
MemoryAccounting=true
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
